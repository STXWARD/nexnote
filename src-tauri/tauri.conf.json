{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexnote",
  "version": "0.1.0",
  "identifier": "com.nexnote.personal-library",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Nexnote", "width": 1440, "height": 900, "minWidth": 980, "minHeight": 640, "center": true, "decorations": true }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "icon": ["icons/icon.ico"] }
}
